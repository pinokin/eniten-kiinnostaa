---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="fi">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Eniten kiinnostaa kaikki</h1>
			<p>
				Ihanaa, että löysit tänne! "Eniten kiinnostaa kaikki" on digitaalinen puutarhani, jossa ajatuksillani ja ideoillani on tilaa kasvaa ja kehittyä.
			</p>
			<p>Aiheita, joista olen ainakin ajatellut kirjoitella:</p>
			<ul>
				<li>Indie Web</li>
				<li>Saavutettavuus</li>
				<li>Henkilökohtaisen tiedon hallinta</li>
				<li>Kielten opiskelu</li>
				<li>Käsityöt</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
